APP_NAME=PokéTrivia
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ── Base de datos ─────────────────────────────────────────────────────────────
# Local (MySQL/Laragon):
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=poketriv
DB_USERNAME=root
DB_PASSWORD=

# Producción (PostgreSQL/Render): Render inyecta estas vars automáticamente
# DB_CONNECTION=pgsql
# DB_HOST=...
# DB_PORT=5432
# DB_DATABASE=...
# DB_USERNAME=...
# DB_PASSWORD=...

# ── Sesiones ──────────────────────────────────────────────────────────────────
SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_DRIVER=file
QUEUE_CONNECTION=sync
